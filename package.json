{
  "name": "req-guard-lite",
  "version": "0.1.2",
  "description": "A lightweight in-memory rate limiter middleware for Express.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ameenhyder-v/req-guard-lite.git"
  },
  "homepage": "https://github.com/ameenhyder-v/req-guard-lite#readme",
  "bugs": {
    "url": "https://github.com/ameenhyder-v/req-guard-lite/issues"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "express",
    "middleware",
    "api",
    "guard",
    "request",
    "typescript",
    "express-middleware"
  ],
  "author": "Ameen Hyder <ameenhyder.v@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "express": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.3"
  }
}
